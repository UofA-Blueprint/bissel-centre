# Copy to .env.local and fill in real values. Never commit .env.local.
# See README.md for where each value comes from.

# --- Firebase web SDK (safe to expose to the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin SDK (server only, from the service account JSON) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=
# Keep the literal \n sequences and the surrounding quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Application secrets ---
# Changing these breaks existing encrypted phone numbers / IT Admin logins.
PHONE_ENCRYPTION_KEY=
IT_ID_HASH_PEPPER=
CRON_SECRET=

# --- Local scripts only (not needed to run the app) ---
# Used by scripts/checkOrCreateAdmin.cjs to bootstrap the first IT Admin.
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
NEW_ADMIN_EMAIL=
NEW_ADMIN_FIRST=
NEW_ADMIN_LAST=
